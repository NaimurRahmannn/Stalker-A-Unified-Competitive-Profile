# Copy this file to .env.local and adjust as needed.
#
# Base URL for the STALKER Django API. It MUST include the /api/v1 prefix,
# because every path in src/features/**/api.ts is written relative to it.
# Only change the host/port if your Django server runs somewhere else.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
